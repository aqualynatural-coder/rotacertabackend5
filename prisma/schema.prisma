// RotaCerta - Prisma Schema
// PostgreSQL

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==============================
//  Enums
// ==============================
enum Role {
  ADMIN
  DRIVER
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  IN_TRANSIT
  ARRIVED
  COMPLETED
  FAILED
  CANCELED
}

enum RouteStatus {
  PLANNED
  ACTIVE
  COMPLETED
  CANCELED
}

enum FailureCode {
  CUSTOMER_ABSENT
  WRONG_ADDRESS
  CUSTOMER_REFUSED
  VEHICLE_PROBLEM
  OTHER
}

enum AlertType {
  DELAY
  DEVIATION
  LONG_STOP
  DELIVERY_COMPLETED
  DELIVERY_FAILED
  ROUTE_STARTED
  NEW_DELIVERY
}

// ==============================
//  Users & Auth
// ==============================
model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  avatarUrl    String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  driver       Driver?
  auditLogs    AuditLog[]
  notifications Notification[]
  refreshTokens RefreshToken[]

  @@index([role])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ==============================
//  Driver profile
// ==============================
model Driver {
  id            String   @id @default(cuid())
  userId        String   @unique
  phone         String?
  licenseNumber String?
  vehiclePlate  String?
  vehicleModel  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  routes    Route[]
  deliveries Delivery[]
  pings     LocationPing[]
}

// ==============================
//  Customers
// ==============================
model Customer {
  id         String  @id @default(cuid())
  name       String
  phone      String?
  email      String?
  address    String
  city       String?
  state      String?
  zipCode    String?
  latitude   Float
  longitude  Float
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  deliveries Delivery[]

  @@index([name])
}

// ==============================
//  Routes & Deliveries
// ==============================
model Route {
  id         String      @id @default(cuid())
  name       String
  status     RouteStatus @default(PLANNED)
  driverId   String?
  scheduledFor DateTime
  startedAt  DateTime?
  endedAt    DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  driver     Driver?     @relation(fields: [driverId], references: [id])
  deliveries Delivery[]
  pings      LocationPing[]

  @@index([status])
  @@index([driverId])
}

model Delivery {
  id           String         @id @default(cuid())
  routeId      String?
  customerId   String
  driverId     String?
  sequence     Int            @default(0)
  status       DeliveryStatus @default(PENDING)
  scheduledAt  DateTime?
  arrivedAt    DateTime?
  completedAt  DateTime?
  arrivedLat   Float?
  arrivedLng   Float?
  notes        String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  route     Route?     @relation(fields: [routeId], references: [id])
  customer  Customer   @relation(fields: [customerId], references: [id])
  driver    Driver?    @relation(fields: [driverId], references: [id])
  proof     ProofOfDelivery?
  failure   DeliveryFailure?

  @@index([status])
  @@index([routeId])
  @@index([driverId])
}

model ProofOfDelivery {
  id         String   @id @default(cuid())
  deliveryId String   @unique
  photoUrl   String
  latitude   Float
  longitude  Float
  notes      String?
  createdAt  DateTime @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

model DeliveryFailure {
  id         String      @id @default(cuid())
  deliveryId String      @unique
  code       FailureCode
  notes      String?
  latitude   Float?
  longitude  Float?
  createdAt  DateTime    @default(now())

  delivery Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
}

// ==============================
//  Real-time tracking
// ==============================
model LocationPing {
  id         String   @id @default(cuid())
  driverId   String
  routeId    String?
  latitude   Float
  longitude  Float
  speed      Float?
  heading    Float?
  accuracy   Float?
  recordedAt DateTime
  createdAt  DateTime @default(now())

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)
  route  Route? @relation(fields: [routeId], references: [id])

  @@index([driverId, recordedAt])
  @@index([routeId])
}

// ==============================
//  Notifications & Audit
// ==============================
model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      AlertType
  title     String
  body      String
  data      Json?
  read      Boolean   @default(false)
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([createdAt])
}
